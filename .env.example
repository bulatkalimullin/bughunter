# BugHunter Swarm — пример окружения (скопируйте в .env и поправьте значения)
# Загрузка: `export $(grep -v '^#' .env | xargs)` или pydantic-settings подхватит из среды.

# --- Минимальный локальный прогон (без Docker sandbox) ---
BHS_SANDBOX_MODE=local

# --- Итерации графа (feedback-loop: bug_logger -> test_generator) ---
BHS_MAX_ITERATIONS=1

# --- Опционально: песочница Docker — лимит CPU (ядер), если не задано в state ---
# BHS_SANDBOX_CPU_CORES=1.0

# --- Ollama (LLM для TestGenerator) ---
BHS_OLLAMA_ENABLED=false
BHS_OLLAMA_BASE_URL=http://127.0.0.1:11434
BHS_OLLAMA_MODEL=gemma3:1b
BHS_OLLAMA_TIMEOUT_SEC=120

# --- Хранилища (опционально) ---
# BHS_REDIS_URL=redis://localhost:6379/0
# BHS_MINIO_ENDPOINT=http://localhost:9000
# BHS_MINIO_ACCESS_KEY=bhs
# BHS_MINIO_SECRET_KEY=change-me

# --- Наблюдаемость ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# BHS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
