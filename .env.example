# BugHunter Swarm — пример окружения (скопируйте в .env и поправьте значения)
# Загрузка: `export $(grep -v '^#' .env | xargs)` или pydantic-settings подхватит из среды.

# --- Docker Compose (docker-compose.yml): хост-путь к анализируемому репо и каталог артефактов BHS на хосте ---
# TARGET_REPO=/path/to/project-under-test
# BHS_DOCKER_STATE=./.bhs.docker

# --- Репозиторий для анализа (если не задаёте bhs-run --repo) ---
# BHS_REPO_PATH=/path/to/project-under-test

# --- Минимальный локальный прогон (без Docker sandbox) ---
BHS_SANDBOX_MODE=local

# --- Итерации графа (feedback-loop: bug_logger -> test_generator) ---
BHS_MAX_ITERATIONS=1

# --- Ранний выход: после dedupe в bug_logger, если багов >= порога — finalize (0 = выключено) ---
# BHS_STOP_BUG_COUNT=0

# --- Квота CPU sandbox (суммарное время compileall и т.д.); если не задано — max(120, 3 * BHS_MAX_ITERATIONS) ---
# BHS_SANDBOX_CPU_BUDGET_SECONDS=900

# --- Опционально: песочница Docker — лимит CPU (ядер), если не задано в state ---
# BHS_SANDBOX_CPU_CORES=1.0

# --- Корень репозитория (если bhs-run не из checkout: compose / docker build) ---
# BHS_PROJECT_ROOT=/path/to/bughunter-swarm

# --- Автозапуск перед bhs-run (нужен Docker или Podman в PATH) ---
# BHS_AUTO_OBSERVABILITY=false  # при корневом compose уже поднимаются Prometheus/Grafana — дублирование из bhs-run не нужно
# BHS_AUTO_SANDBOX_IMAGE=false
# BHS_SKIP_AUTO_OLLAMA=false

# --- Ollama (LLM для TestGenerator) ---
BHS_OLLAMA_ENABLED=false
BHS_OLLAMA_BASE_URL=http://127.0.0.1:11434
BHS_OLLAMA_MODEL=gemma3:1b
BHS_OLLAMA_TIMEOUT_SEC=120
# BHS_OLLAMA_PULL_TIMEOUT_SEC=3600

# --- Хранилища (опционально) ---
# BHS_REDIS_URL=redis://localhost:6379/0
# BHS_MINIO_ENDPOINT=http://localhost:9000
# BHS_MINIO_ACCESS_KEY=bhs
# BHS_MINIO_SECRET_KEY=change-me

# --- Наблюдаемость ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# BHS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
